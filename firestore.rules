rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Checks if user is the Owner (Super Admin)
    function isOwner() {
      return request.auth != null && request.auth.token.email == "theboiblazin2026@gmail.com";
    }

    // Helper: Checks if user is an Admin (can read dashboard)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "theboiblazin2026@gmail.com" || 
        request.auth.token.email == "admin@verify.com" ||
        request.auth.token.email == "admin@nexus.com" ||
        request.auth.token.email == "admin@test.com" // Test Admin
      );
    }
    
    // Website Content:
    // 1. Public can READ
    // 2. admins can READ (implicit)
    // 3. ONLY Owner can WRITE
    match /content/{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Service Requests:
    match /requests/{requestId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    // User Management:
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() ||
        (resource.data.companyId == request.auth.uid) // Allow Fleet Manager to read their drivers
      );
      
      // Users can update their own profile (non-sensitive) + companyId
      allow update: if request.auth != null && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'membership', 'createdBy', 'role'])
      );
      
      // Only Owner can create/delete/modify sensitive fields
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // User Files - users can only access their own files
    match /userFiles/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if isAdmin(); // Admin can see all files for support
    }
    // Notifications:
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if isAdmin(); // Only admins can create notifications
      allow update: if request.auth != null && request.auth.uid == resource.data.userId; // Users can mark as read
    }
  }
}
